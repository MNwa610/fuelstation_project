# PostgreSQL
POSTGRES_PASSWORD="change-me"
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:change-me@localhost:5432/fuelstation?schema=public"

# Server
JWT_SECRET="change-me-in-production"
PORT=3000

# Client (Vite локально читает корневой .env)
# Для docker compose клиент собирается с пустым VITE_API_URL:
# браузер ходит на тот же хост, Nginx проксирует /api на server:3000.
VITE_API_URL="http://localhost:3000"
VITE_YANDEX_MAPS_KEY="your-yandex-maps-key"
